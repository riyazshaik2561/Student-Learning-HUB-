# Generate a unique random value (32+ characters) for production.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Optional AI provider. Leave AI_API_KEY empty to use local fallback guidance.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional first-run administrator. Remove these after account creation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
